# InHouseCloud: environment for docker/compose.yml.
#
# install.sh generates the real .env (mode 0600) in the install directory from the
# answers or from bootstrap/config.yaml, and fills every *_PASSWORD, *_SECRET*, *_TOKEN
# and *_KEY with random values. This file documents every variable and holds no real
# value. Copy it by hand only if you are bypassing the installer.

# ----------------------------------------------------------------- compose
COMPOSE_PROJECT_NAME=ihc        # project name; container names start with it
COMPOSE_PROFILES=                   # optional profiles, comma separated: storage,ops,cloudflared,tailscale,backup
IHC_NETWORK=ihc             # the internal Docker network; apps join it by this name
IHC_OPS_NETWORK=ihc-ops     # the ops tools' network: the proxy and the ops profile only, never apps

# ----------------------------------------------------------------- ingress
# See the valid matrix in docs/install-design.md; install.sh refuses anything else.
INGRESS=local                       # local | private | public
BASE_DOMAIN=cloud.localhost       # every service is <name>.<BASE_DOMAIN>
PUBLIC_BASE_URL=http://portal.cloud.localhost   # the portal URL users type
TLS_MODE=off                        # off | internal | edge | acme
TUNNEL_PROVIDER=none                # none | tailscale | cloudflared
BIND_ADDRESS=127.0.0.1              # where the proxy and Gitea SSH listen; 127.0.0.1 for local and private (the tailnet goes through the Tailscale node), 0.0.0.0 for public
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
PROXY_ADMIN_PORT=81                 # proxy admin UI/API, always on 127.0.0.1
GITEA_SSH_PORT=2222
AUTHENTIK_LOCAL_PORT=9000           # loopback control port used by first-run and smoke tests
GITEA_LOCAL_PORT=3000               # loopback control port used by first-run and smoke tests

# Derived hostnames and URLs (install.sh fills them from the ingress answers)
PORTAL_HOST=portal.cloud.localhost
AUTHENTIK_HOST=auth.cloud.localhost
GITEA_HOST=git.cloud.localhost
PORTAL_BASE_URL=http://portal.cloud.localhost
AUTHENTIK_BASE_URL=http://auth.cloud.localhost
GITEA_BASE_URL=http://git.cloud.localhost

# ------------------------------------------------------------------ images
PROXY_IMAGE=jc21/nginx-proxy-manager:2.16.0
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server:2026.8.4
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
GITEA_IMAGE=gitea/gitea:28.2
GITEA_RUNNER_IMAGE=gitea/act_runner:0.6.1
GARAGE_IMAGE=dxflrs/garage:v2.4.1
PORTAINER_IMAGE=portainer/portainer-ce:2.45.2-alpine
GLANCES_IMAGE=nicolargo/glances:4.5.8-full
# Wetty v4 has no version tags on Docker Hub: sha-ab1eb68 is the commit of the v4.0.1 release.
WETTY_IMAGE=wettyoss/wetty:sha-ab1eb68
FILEBROWSER_IMAGE=filebrowser/filebrowser:v2.63.23
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.1
TAILSCALE_IMAGE=tailscale/tailscale:v1.104.1
# tailnet-dns (ingress private): answers *.<BASE_DOMAIN> with the box's tailnet address.
COREDNS_IMAGE=coredns/coredns:1.14.7

# ------------------------------------------------------------------- proxy
PROXY_ADMIN_EMAIL=admin@example.com # Nginx Proxy Manager admin (API user for first-run)
PROXY_ADMIN_PASSWORD=               # generated

# --------------------------------------------------------------- authentik
AUTHENTIK_SECRET_KEY=               # generated, 64 chars
AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_PASSWORD=              # generated
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com   # the akadmin account's email
AUTHENTIK_BOOTSTRAP_PASSWORD=       # generated; replace it after the first MFA enrollment
AUTHENTIK_BOOTSTRAP_TOKEN=          # generated; API token used by first-run and smoke tests
AUTHENTIK_PORTAL_GROUP=ihc-admins   # group bound to the portal application
AUTHENTIK_APP_GROUP=ihc-users       # group bound to Gitea and to apps by default
AUTHENTIK_OUTPOST_ID=               # filled by first-run: embedded outpost uuid (not a secret)

# ------------------------------------------------------------------- gitea
GITEA_ADMIN_USERNAME=admin
GITEA_ADMIN_PASSWORD=               # generated
GITEA_ADMIN_EMAIL=admin@example.com
GITEA_ADMIN_TOKEN=                  # filled by first-run: admin API token (scope all)
GITEA_READONLY_TOKEN=               # filled by first-run: read-only token used by smoke tests
GITEA_ORGANIZATION=company
GITEA_SMOKE_REPOSITORY=             # filled by first-run: <GITEA_BASE_URL>/<org>/ihc-smoke.git (smoke test 12)
GITEA_ENABLE_ACTIONS=true
GITEA_REQUIRE_SIGNIN_VIEW=true      # company Git: sign in to view
GITEA_OIDC_ENABLED=true
GITEA_OIDC_SOURCE_NAME=authentik    # the OIDC source name; the callback is /user/oauth2/<name>/callback
GITEA_OIDC_CLIENT_ID=               # generated (not secret; it is the OAuth2 client id)
GITEA_OIDC_CLIENT_SECRET=           # generated
GITEA_DB_NAME=gitea                 # Gitea's own database on the shared Postgres
GITEA_DB_USER=gitea                 # LOGIN NOSUPERUSER, owner of that database
GITEA_DB_PASSWORD=                  # generated

# -------------------------------------------------------- shared postgres
POSTGRES_DB=ihc
POSTGRES_USER=ihc               # superuser of the shared Postgres; apps get their own roles
POSTGRES_PASSWORD=                  # generated
PORTAL_DB_NAME=ihc_platform     # the portal's own database on the shared Postgres
PORTAL_DB_ROLE=ihc_platform     # LOGIN NOSUPERUSER
PORTAL_DB_PASSWORD=                 # generated

# ------------------------------------------------------------------ portal
PORTAL_BUILD_CONTEXT=./portal-placeholder   # the placeholder app; the real portal replaces it
PORTAL_SUPER_ADMIN_EMAILS=admin@example.com # comma separated
IHC_PORTAL_API_TOKEN=               # filled by first-run: read-only bearer for GET /api/platform/status (docs/portal-api.md)

# ----------------------------------------------------------------- storage
# Garage (the storage profile). install.sh renders <install-dir>/garage/garage.toml without
# secrets; the three below reach the container as environment variables. None of them
# ever goes to an app: each app gets its own key, limited to its bucket, in apps/<slug>/.env.
GARAGE_RPC_SECRET=                  # generated, 64 hex chars; the node's RPC and CLI secret
GARAGE_ADMIN_TOKEN=                 # generated; admin API on garage:3903, not routed by the proxy
GARAGE_METRICS_TOKEN=               # generated; /metrics on the admin port
GARAGE_S3_REGION=garage             # the region clients sign with (S3_REGION in apps)
GARAGE_CAPACITY=100G                # the node's capacity in the layout (storage.capacity)
GARAGE_LOG_LEVEL=garage=info

# ---------------------------------------------------------------------- ci
GITEA_RUNNER_TOKEN=                 # filled by install.sh (gitea actions generate-runner-token)
GITEA_DEPLOY_RUNNER_TOKEN=          # filled by install.sh: registration token scoped to GITEA_ORGANIZATION
GITEA_RUNNER_NAME=ihc-runner    # the deploy runner registers as <name>-deploy
GITEA_RUNNER_LABELS=ubuntu-latest:docker://node:22-bookworm   # CI runner labels; the deployer's is ihc-deploy
DOCKER_SOCKET=/var/run/docker.sock  # filled by install.sh: the daemon socket as the host sees it (rootless: $XDG_RUNTIME_DIR/docker.sock)

# ----------------------------------------------------------------- tunnels
CLOUDFLARED_TUNNEL_TOKEN=           # read from the env named in config (ingress.cloudflared.tunnel_token_env)
# Tailscale (ingress private). The auth key is NOT kept here: install.sh reads
# IHC_TAILSCALE_AUTHKEY from its environment for the first login only; the node then
# runs on its state in the tailscale-state volume. A value left by an older install is blanked.
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=ihc          # the node's name on the tailnet (ingress.tailscale.hostname)
TAILSCALE_IP=                       # filled by install.sh: the node's tailnet IPv4 (not a secret)
TAILSCALE_DNS_NAME=                 # filled by install.sh: the node's MagicDNS name
PROXY_CERTIFICATE_ID=               # filled by first-run (TLS internal): the wildcard certificate's id on the proxy

# ------------------------------------------------------------------ backup
# The backup job (docs/backup.md): the `backup` profile, on when BACKUP_ENABLED=true.
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *           # cron expression, in BACKUP_TZ
BACKUP_TZ=UTC
BACKUP_MAX_RUN_MINUTES=240          # hard timeout: a run past this is killed and recorded as failed
BACKUP_MAX_AGE_HOURS=26             # verify and status call the newest success stale past this
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BACKUP_DESTINATION=                 # host directory: restic/ repository + reports/; from IHC_BACKUP_DESTINATION, default <install-dir>/backups
BACKUP_ENCRYPTION_KEY=              # restic repository password; from IHC_BACKUP_ENCRYPTION_KEY or generated. Keep a copy off the box
BACKUP_PG_CLIENT_PACKAGE=postgresql16-client   # Alpine package matching the major of POSTGRES_IMAGE
BACKUP_BUILD_CONTEXT=./backup-job   # assembled by install.sh from docker/backup and scripts/ihc-backup.sh

# --------------------------------------------------------------------- ops
# The ops profile's admin tools (docs/install-design.md, docs/security.md). Filled by
# install.sh; reachable only through the proxy, forward auth bound to ihc-admins.
OPS_TERMINAL=false                  # true when the preflight found an sshd: first-run then routes terminal.<BASE_DOMAIN>
WETTY_SSH_HOST=host.docker.internal # how the Wetty container reaches the host's sshd; the host's address when host-gateway does not answer
WETTY_SSH_PORT=22                   # the port the host's sshd listens on (found by the preflight)
WETTY_SSH_USER=                     # the user the web terminal signs in as: the user that ran install.sh
WETTY_ORIGIN=http://terminal.cloud.localhost   # the only browser origin Wetty accepts
WETTY_KEY_DIR=                      # <install-dir>/local/wetty: id_ed25519 (dedicated key) and known_hosts
FILEBROWSER_APP_DATA_DIR=           # <install-dir>/app-data (ops.filebrowser.paths.app_data)
FILEBROWSER_REPORTS_DIR=            # <BACKUP_DESTINATION>/reports, mounted read only (ops.filebrowser.paths.backup_reports)
AUTHENTIK_SMOKE_USER=ihc-smoke-user   # a member of ihc-users only; smoke test 18 proves it is denied the ops tools
AUTHENTIK_SMOKE_USER_PASSWORD=      # generated; exists only here

# ------------------------------------------------------------------- agent
# The agent profile (docs/operator-contract.md, docs/security.md): an operator agent on
# the box, opt-in. install.sh fills the paths; the keys and tokens below are NEVER
# generated: a human writes them here (or exports IHC_<NAME> before install.sh).
# OpenClaw publishes dated release tags; 2026.10.5 is the one this project was tested with.
OPENCLAW_IMAGE=openclaw/openclaw:2026.10.5-slim
# agent-docker-proxy runs agent-proxy/docker-ro-proxy.py (standard library only) on this image.
AGENT_PROXY_IMAGE=python:3.13.16-alpine3.23
IHC_AGENT_NETWORK=ihc-agent  # internal network: the agent and its read-only Docker API only
AGENT_DIR=                          # <install-dir>/agent: state/, workspace/, reference/ (read only in the container)
AGENT_USER=                         # 0:0 under rootless Docker (that is the installing user), else uid:gid of that user
AGENT_ALLOW_WRITE=false             # ops.agent.allow_write: true lets it restart app containers and prune the build cache
AGENT_BACKUP_REPORTS_DIR=           # <BACKUP_DESTINATION>/reports, mounted read only
AGENT_MODEL=                        # ops.agent.model, e.g. anthropic/<model>; empty: OpenClaw's default for the key
AGENT_ALLOW_FROM=                   # ops.agent.allow_from: chat user ids allowed to talk to it; empty: pairing
AGENT_GROUPS=                       # ops.agent.groups: Telegram group chat ids, answered on a mention only
AGENT_GROUP_ALLOW_FROM=             # ops.agent.group_allow_from (default allow_from): who it answers there
AGENT_MEM_LIMIT=3g                  # the agent container's memory limit; the box needs 6 GiB with the agent on
AGENT_NODE_HEAP_MB=1024             # V8 old-space limit of each OpenClaw process (NODE_OPTIONS)
AGENT_TZ=UTC
AGENT_ANTHROPIC_API_KEY=            # the LLM key (one of these two); a human sets it
AGENT_OPENAI_API_KEY=
AGENT_SLACK_BOT_TOKEN=              # Slack, Socket Mode: bot token (xoxb-) and app token (xapp-)
AGENT_SLACK_APP_TOKEN=
AGENT_TELEGRAM_BOT_TOKEN=           # or Telegram: the BotFather token
AGENT_GITEA_TOKEN=                  # optional, made by a human: lets the agent re-run a deploy (runbooks/redeploy-app.md)
