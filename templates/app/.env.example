# Variables the app reads. No real values here, ever.
# On the box, ihc-app provision writes the real file with PORT, APP_BASE_URL,
# DATABASE_URL (and PG*), REDIS_URL, REDIS_PREFIX and, when asked for, S3_*.
# LOCAL_* values are for a laptop only and never reach the box.
PORT=8080
LOCAL_AUTH_MOCK_EMAIL=dev@example.com
LOCAL_AUTH_MOCK_NAME=Local Dev
