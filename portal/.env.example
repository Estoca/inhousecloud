# InHouseCloud portal: variaveis de ambiente.
# Copie para .env e preencha. Nenhum valor real de segredo entra neste arquivo.
# Os padroes abaixo sao os de uma instalacao local do InHouseCloud (cloud.localhost);
# cada instalacao troca so isto.

# --- Identidade da instalacao ---------------------------------------------
# Nome da empresa (aparece em textos e na UI).
COMPANY_NAME=Company
# Dominio base dos apps: cada app vive em <slug>.<BASE_DOMAIN>.
BASE_DOMAIN=cloud.localhost
# Host publico do portal. Padrao: portal.<BASE_DOMAIN>.
PORTAL_HOST=portal.cloud.localhost
PUBLIC_BASE_URL=http://portal.cloud.localhost
# Dominios de e-mail da organizacao, separados por virgula. Quem tem e-mail
# nesses dominios entra no portal como viewer.
ORG_EMAIL_DOMAINS=example.com
# Nome do manifesto na raiz do repo do app e apelidos aceitos pela CLI.
MANIFEST_FILENAME=company-app.yaml
MANIFEST_FILENAME_ALIASES=app.yaml

# --- Servidor ---------------------------------------------------------------
# Loopback por padrao: so o proxy fala com o portal. Em container, 0.0.0.0.
HOST=127.0.0.1
PORT=8006
# Fuso usado nos agendamentos (snapshots de disco e de acessos).
TIMEZONE=UTC

# --- Gitea (fonte dos deploys) ---------------------------------------------
# URL que o portal usa para falar com a API (dentro do container, host.docker.internal).
GITEA_URL=http://localhost:3007
DOCKER_GITEA_URL=http://host.docker.internal:3007
# URL publica, usada nos links e para reconhecer repo_url dos apps.
GITEA_PUBLIC_URL=http://git.cloud.localhost
# Organizacao onde ficam os apps.
GITEA_ORG=company
# Token SOMENTE LEITURA (escopo read:repository) para listar runs do Actions.
GITEA_TOKEN=

# --- Authentik / proxy -------------------------------------------------------
AUTHENTIK_URL=http://auth.cloud.localhost
# Topologia do proxy: host que os proxy hosts do NPM usam como upstream e o
# outpost do Authentik (nomes de servico na rede do cloud). So informativo: aparece em /api/platform/status.
UPSTREAM_HOST=proxy
OUTPOST_HOST=authentik-server
OUTPOST_PORT=9000
# Nginx Proxy Manager (leitura das rotas e teste de login na pagina Plataforma).
NPM_URL=http://localhost:81
DOCKER_NPM_URL=http://host.docker.internal:81
NPM_EMAIL=
NPM_PASSWORD=

# --- Deploy na maquina ---------------------------------------------------------
# Raiz onde o workflow do Gitea faz checkout e sobe o Compose de cada app:
# <DEPLOY_ROOT>/<owner_email>/<app_slug>.
DEPLOY_ROOT=/opt/inhousecloud/apps
# Faixa de portas fixas aprovadas para apps novos (prefira deploy.port: auto).
PORT_RANGE=8100-8999
# Inventario real dos apps (fora do repo e da imagem). Sem ele, o portal usa
# inventory/apps.example.json e avisa.
INVENTORY_PATH=./inventory/apps.json

# --- Banco do portal ------------------------------------------------------------
DATABASE_URL=postgresql://ihc_platform:change-me@localhost:5432/ihc_platform
DOCKER_DATABASE_URL=postgresql://ihc_platform:change-me@host.docker.internal:5432/ihc_platform
# Credencial exclusiva, somente leitura, do provider de catálogo para o
# mcp-gateway. Unico token que o portal aceita.
CATALOG_MCP_TOKEN=
RECORD_STATUS_EVENTS=false

# --- Pagina Plataforma (saude dos servicos centrais) -------------------------
# Usuario SOMENTE LEITURA do Postgres compartilhado (SELECT 1 e tamanho dos bancos).
PLATFORM_PG_READONLY_URL=
# Redis compartilhado (PING).
REDIS_URL=
# Usado pelo env-plan dos apps (REDIS_URL dos apps) e como fallback do PING.
SHARED_REDIS_URL=
MINIO_ENDPOINT=http://s3.cloud.localhost
CLOUDFLARED_CONTAINER=cloudflared
GITEA_RUNNER_CONTAINER=gitea-runner
# Pasta no host com o status do job de backup; o compose monta em /backup-reports (ro).
# Exemplo: <destino do backup>/reports
BACKUP_REPORTS_DIR=./backup-reports
# Glob do arquivo mais novo do backup (so * e ? no nome do arquivo). Vazio = "no backup configured".
# Com o mount acima: /backup-reports/latest-status.json
BACKUP_MANIFEST_GLOB=
BACKUP_MAX_AGE_HOURS=26
PORTAINER_URL=http://portainer.cloud.localhost
GLANCES_URL=http://monitor.cloud.localhost
PLATFORM_STATUS_TIMEOUT_MS=3000
HEALTHCHECK_TIMEOUT_MS=2500

# --- Cache das telas de status (apps, runtime, plataforma) ---------------------
# O portal serve /api/apps-status, /api/platform/status, /api/apps-runtime,
# /api/apps-npm e /api/runtime/* do cache e atualiza em segundo plano quando a
# entrada passa do TTL (stale-while-revalidate). Ver README, "Cache das telas de status".
# Redis do cache. Vazio = usa REDIS_URL; sem nenhum dos dois, cache em memoria do
# processo (some a cada rebuild). Dentro do container, o Redis compartilhado da
# maquina fica em host.docker.internal. Chaves com prefixo deploy-platform:.
STATUS_CACHE_REDIS_URL=
# TTL em segundos: apps-status, apps-runtime, apps-npm e runtime/* (padrao 300).
STATUS_CACHE_TTL_SECONDS=300
# TTL em segundos da pagina Plataforma (padrao 60).
PLATFORM_STATUS_TTL_SECONDS=60
# Timeout de cada operacao no Redis; estourou, cai para memoria por 30 s.
STATUS_CACHE_REDIS_TIMEOUT_MS=1500
# Nome antigo (ms), ainda aceito quando STATUS_CACHE_TTL_SECONDS esta vazio.
# APPS_STATUS_CACHE_TTL_MS=300000

# --- Snapshots diarios --------------------------------------------------------------
DISK_USAGE_SNAPSHOT_ENABLED=true
DISK_USAGE_SNAPSHOT_HOUR=3
DISK_USAGE_SNAPSHOT_MINUTE=0

# Super admins separados por virgula. Admins comuns ficam na tabela portal_admins.
SUPER_ADMIN_EMAILS=

# Grupos do Authentik do cloud (informativos por enquanto; o papel ainda vem de
# SUPER_ADMIN_EMAILS, portal_admins e ORG_EMAIL_DOMAINS).
ADMIN_GROUP=ihc-admins
USER_GROUP=ihc-users

